# Supabase Configuration
# Get these from your Supabase project settings
# https://supabase.com/dashboard/project/<project-id>/settings/api
VITE_SUPABASE_PROJECT_ID=your_project_id_here
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_public_key_here
VITE_SUPABASE_URL=https://your_project_id.supabase.co

# Twitch Streaming Configuration
# RTMP URL for Twitch (default is fine, stream key is entered in UI)
VITE_TWITCH_RTMP_URL=rtmp://live.twitch.tv/app/

# SRS Media Server Configuration (REQUIRED for Twitch streaming)
# Run ./start-srs.sh to start the local SRS server
VITE_SRS_SERVER_URL=http://localhost:1985

# Option 2: AWS IVS (Interactive Video Service)
# VITE_IVS_INGEST_ENDPOINT=rtmps://xxx.global-contribute.live-video.net:443/app/
# VITE_IVS_STREAM_KEY=your_stream_key

# Option 3: Mux Live Streaming
# VITE_MUX_STREAM_URL=rtmp://live.mux.com/app/
# VITE_MUX_TOKEN_ID=your_token_id
# VITE_MUX_TOKEN_SECRET=your_token_secret
